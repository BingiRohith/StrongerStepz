# Copy this file to .env.local and fill in real values. Never commit real
# secrets here — this file is a template, .env.local is gitignored.

# --- Database ---
MONGODB_URI=

# --- Admin auth ---
JWT_SECRET=
JWT_EXPIRES_IN=7d
ADMIN_SESSION_COOKIE_NAME=ss_admin_session

# --- Admin seed (used only by `npm run seed`, never read at runtime) ---
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

# --- Razorpay (use test-mode keys in dev; switching to live mode is an env-var
# swap only, no code changes — see src/lib/payments/razorpay.ts) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# --- Cloudinary (all image/PDF uploads go through src/lib/uploads/**;
# server-side only, no NEXT_PUBLIC_ variant needed) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Site ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
